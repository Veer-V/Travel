# SmartVoyage AI Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="SmartVoyage AI"

# Security
SECRET_KEY="smartvoyage-dev-secret-key-change-in-production-min-32-chars"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite development fallback:
DATABASE_URL=sqlite:///./smartvoyage.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/smartvoyage

# External Provider API Keys (Optional with built-in fallbacks)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
OSRM_ROUTING_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
OPENCAGE_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006","*"]

# Data & Models paths
DATASET_DIR=./datasets/sample
MODEL_DIR=./ml/models
